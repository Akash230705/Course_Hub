pipeline {
    agent any

    tools {
        maven 'maven'
    }

    parameters {
        choice(
        name: 'ACTION',
        choices: [
            'DEPLOY_APP',
            'REMOVE_APP',
            'DEPLOY_DB',
            'REMOVE_DB'
        ],
        description: 'Choose Action'
        )
    }

    stages {

        stage('Execute') {

            steps {

                script {

                    if(params.ACTION=="DEPLOY_APP") {
                        sh '''
                        scp -r deployment ansible@172.31.30.60:/home/ansible/Course_Hub/
                        ansible dev -m shell -a ansible dev -m shell -a "
                        kubectl apply -f /home/ansible/Course_Hub/deployment/namespace.yml &&
                        kubectl apply -f /home/ansible/Course_Hub/deployment/app-deployment.yml &&
                        kubectl apply -f /home/ansible/Course_Hub/deployment/app-service.yml
                        "
                        '''
                    }

                    else if(params.ACTION == "REMOVE_APP") {
                        sh '''
                        scp -r deployment ansible@172.31.30.60:/home/ansible/Course_Hub/

                        ansible dev -m shell -a "
                        kubectl delete -f /home/ansible/Course_Hub/deployment/app-deployment.yml --ignore-not-found=true &&
                        kubectl delete -f /home/ansible/Course_Hub/deployment/app-service.yml --ignore-not-found=true
                        "
                        '''
                    }

                    else if(params.ACTION == "DEPLOY_DB") {
                        sh '''
                        scp -r deployment ansible@172.31.30.60:/home/ansible/Course_Hub/
                        ansible dev -m shell -a "
                        kubectl apply -f /home/ansible/Course_Hub/deployment/pv.yml &&
                        kubectl apply -f /home/ansible/Course_Hub/deployment/pvc.yml &&
                        kubectl apply -f /home/ansible/Course_Hub/deployment/mysql-service.yml &&
                        kubectl apply -f /home/ansible/Course_Hub/deployment/mysql-statefulset.yml
                        "
                        '''
                    }

                    else if(params.ACTION == "REMOVE_DB") {
                        sh '''
                        scp -r deployment ansible@172.31.30.60:/home/ansible/Course_Hub/
                        ansible dev -m shell -a "
                        kubectl delete -f /home/ansible/Course_Hub/deployment/mysql-statefulset.yml --ignore-not-found=true &&
                        kubectl delete -f /home/ansible/Course_Hub/deployment/mysql-service.yml --ignore-not-found=true &&
                        kubectl delete -f /home/ansible/Course_Hub/deployment/pvc.yml --ignore-not-found=true &&
                        kubectl delete -f /home/ansible/Course_Hub/deployment/pv.yml --ignore-not-found=true
                        "
                        '''
                    }

                }

            }
            post {
                success {
                    echo "Deployment completed successfully."
                }
                failure {
                    echo "Deployment failed."
                }
                always {
                    echo "Pipeline execution finished."
                }
            }

        }

    }

}   