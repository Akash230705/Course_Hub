pipeline {
    agent any

    tools {
        maven 'maven'
    }

    parameters {
        choice(
        name: 'ACTION',
        choices: [
            'DEPLOY_APP',
            'REMOVE_APP',
            'DEPLOY_DB',
            'REMOVE_DB'
        ],
        description: 'Choose Action'
        )
    }

    stages {

        stage('Execute') {

            steps {

                script {

                    if(params.ACTION=="DEPLOY_APP"){
                        sh """
                        ssh ubuntu@ip-172-31-30-60 '
                        kubectl apply -f /home/ubuntu/Course_Hub/deployment/app-deployment.yaml
                        kubectl apply -f /home/ubuntu/Course_Hub/deployment/app-service.yaml
                        '
                        """
                    }

                    if(params.ACTION=="REMOVE_APP"){
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@ip-172-31-30-60 '
                                kubectl delete -f /home/ubuntu/Course_Hub/deployment/app-deployment.yaml --ignore-not-found=true
                                kubectl delete -f /home/ubuntu/Course_Hub/deployment/app-service.yaml --ignore-not-found=true
                            '
                        """
                    }

                    if(params.ACTION=="DEPLOY_DB"){
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@ip-172-31-30-60 '
                                kubectl apply -f /home/ubuntu/Course_Hub/deployment/pv.yaml
                                kubectl apply -f /home/ubuntu/Course_Hub/deployment/pvc.yaml
                                kubectl apply -f /home/ubuntu/Course_Hub/deployment/mysql-service.yaml
                                kubectl apply -f /home/ubuntu/Course_Hub/deployment/mysql-statefulset.yaml
                            '
                        """
                    }

                    if(params.ACTION=="REMOVE_DB"){
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@ip-172-31-30-60 '
                                kubectl delete -f /home/ubuntu/Course_Hub/deployment/mysql-statefulset.yaml --ignore-not-found=true
                                kubectl delete -f /home/ubuntu/Course_Hub/deployment/mysql-service.yaml --ignore-not-found=true
                                kubectl delete -f /home/ubuntu/Course_Hub/deployment/pvc.yaml --ignore-not-found=true
                                kubectl delete -f /home/ubuntu/Course_Hub/deployment/pv.yaml --ignore-not-found=true
                            '
                        """
                    }

                }

            }
            post {
                success {
                    echo "Deployment completed successfully."
                }
                failure {
                    echo "Deployment failed."
                }
                always {
                    echo "Pipeline execution finished."
                }
            }

        }

    }

}   